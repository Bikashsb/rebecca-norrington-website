---
const navLinks = [
  { href: "/about", label: "About" },
  { href: "/books", label: "Books" },
  { href: "/services", label: "Services" },
  { href: "/retreats", label: "Retreats" },
  { href: "/interviews", label: "Interviews" },
  { href: "/ask-rebecca", label: "Ask Rebecca" },
  { href: "/blog", label: "Blog" },
  { href: "/contact", label: "Contact" },
];

const currentPath = Astro.url.pathname;
---

<header
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  x-data="{ scrolled: false, open: false }"
  x-init="window.addEventListener('scroll', () => { scrolled = window.scrollY > 60 })"
  :class="scrolled ? 'bg-cream/95 backdrop-blur-md shadow-sm py-3' : 'bg-transparent py-5'"
>
  <div class="max-w-7xl mx-auto px-6 flex items-center justify-between">
    <!-- Logo / Name -->
    <a href="/" class="group flex flex-col leading-none">
      <span
        class="font-display font-medium transition-colors duration-200"
        :class="scrolled ? 'text-charcoal text-xl' : 'text-white text-xl'"
      >
        Rebecca L. Norrington
      </span>
      <span
        class="text-xs tracking-widest uppercase transition-colors duration-200"
        :class="scrolled ? 'text-terracotta' : 'text-gold'"
      >
        Happiness Specialist
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-7">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`text-sm tracking-wide transition-colors duration-200 hover:text-terracotta ${
            currentPath === link.href ? "text-terracotta font-medium" : ""
          }`}
          :class={`scrolled ? 'text-charcoal' : 'text-white/90'`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Donation CTA -->
    <div class="hidden lg:flex items-center gap-3">
      <a
        href="/donation"
        class="px-5 py-2 rounded-full text-sm font-medium tracking-wide transition-all duration-200 bg-terracotta text-white hover:bg-terracotta-dark"
      >
        Make a Donation
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      class="lg:hidden p-2 rounded-lg"
      :class="scrolled ? 'text-charcoal' : 'text-white'"
      @click="open = !open"
      aria-label="Toggle menu"
    >
      <svg x-show="!open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg x-show="open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div
    x-show="open"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="lg:hidden bg-cream border-t border-cream-dark shadow-lg"
  >
    <nav class="flex flex-col px-6 py-4 gap-1">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`py-3 text-charcoal font-medium border-b border-cream-dark hover:text-terracotta transition-colors ${
            currentPath === link.href ? "text-terracotta" : ""
          }`}
          @click="open = false"
        >
          {link.label}
        </a>
      ))}
      <a
        href="/donation"
        class="mt-4 px-5 py-3 rounded-full text-center text-sm font-medium bg-terracotta text-white hover:bg-terracotta-dark transition-colors"
        @click="open = false"
      >
        Make a Donation
      </a>
    </nav>
  </div>
</header>
