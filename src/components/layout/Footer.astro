const quickLinks = [
  { href: "/about", label: "About Rebecca" },
  { href: "/books", label: "Books" },
  { href: "/services", label: "Services & Classes" },
  { href: "/retreats", label: "Retreats & Workshops" },
  { href: "/testimonials", label: "Testimonials" },
  { href: "/ask-rebecca", label: "Ask Rebecca" },
  { href: "/interviews", label: "Interviews" },
  { href: "/blog", label: "Blog" },
];
---

<footer class="bg-charcoal text-white">
  <!-- Main Footer -->
  <div class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">

      <!-- Brand Column -->
      <div class="lg:col-span-1">
        <h3 class="font-display text-2xl font-light text-white mb-2">Rebecca L. Norrington</h3>
        <p class="text-gold text-sm tracking-widest uppercase mb-5">Happiness Specialist</p>
        <p class="text-white/60 text-sm leading-relaxed mb-6">
          "You cannot have a happy ending to an unhappy journey."
          <br /><em class="text-white/40 text-xs">— Abraham-Hicks</em>
        </p>
        <div class="flex gap-3">
          {socialLinks.map(link => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.label}
              class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center text-white/70 hover:bg-terracotta hover:text-white transition-all duration-200"
              set:html={link.icon}
            />
          ))}
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-sm tracking-widest uppercase text-white/50 mb-5">Explore</h4>
        <ul class="space-y-3">
          {quickLinks.map(link => (
            <li>
              <a href={link.href} class="text-white/70 text-sm hover:text-terracotta transition-colors duration-200">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h4 class="text-sm tracking-widest uppercase text-white/50 mb-5">Work with Rebecca</h4>
        <ul class="space-y-3">
          <li><a href="/services#one-on-one" class="text-white/70 text-sm hover:text-terracotta transition-colors duration-200">One-on-One Sessions</a></li>
          <li><a href="/services#happiness-course" class="text-white/70 text-sm hover:text-terracotta transition-colors duration-200">The Truth About Happiness</a></li>
          <li><a href="/services#fitness" class="text-white/70 text-sm hover:text-terracotta transition-colors duration-200">Fitness Classes</a></li>
          <li><a href="/retreats" class="text-white/70 text-sm hover:text-terracotta transition-colors duration-200">Retreats & Workshops</a></li>
          <li>
            <a
              href="https://calendly.com/realityspirituality"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gold text-sm hover:text-gold/80 transition-colors duration-200 flex items-center gap-1"
            >
              Book Free Consultation
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact & Donation -->
      <div>
        <h4 class="text-sm tracking-widest uppercase text-white/50 mb-5">Connect</h4>
        <div class="space-y-4 mb-6">
          <a href="mailto:rln@rebeccanorrington.com" class="flex items-center gap-2 text-white/70 text-sm hover:text-terracotta transition-colors">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            rln@rebeccanorrington.com
          </a>
          <a href="http://www.realityspirituality.com/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-white/70 text-sm hover:text-terracotta transition-colors">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
            </svg>
            RealitySpirituality Radio
          </a>
        </div>
        <a
          href="https://www.paypal.com/paypalme/rebeccalnorrington/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-gold text-charcoal text-sm font-medium hover:bg-gold-dark transition-colors duration-200"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
          </svg>
          Support Rebecca
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-6 py-5 flex flex-col sm:flex-row justify-between items-center gap-3">
      <p class="text-white/40 text-xs">
        © {new Date().getFullYear()} Rebecca L. Norrington. All rights reserved.
      </p>
      <div class="flex gap-5">
        <a href="/privacy" class="text-white/40 text-xs hover:text-white/60 transition-colors">Privacy Policy</a>
        <a href="/terms" class="text-white/40 text-xs hover:text-white/60 transition-colors">Terms & Conditions</a>
      </div>
    </div>
  </div>
</footer>
