---
import BaseLayout from '../components/layout/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import testimonials from '../data/testimonials.json';
---

<BaseLayout
  title="Testimonials"
  description="Read what clients and students say about working with Rebecca L. Norrington — happiness coaching, fitness classes, and life coaching."
>

  <!-- Page Hero -->
  <section class="relative min-h-[60vh] flex items-center overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/slide2-1-1024x683-700x467.jpg" alt="" class="w-full h-full object-cover object-center" />
      <div class="absolute inset-0 bg-gradient-to-br from-charcoal/80 via-charcoal/50 to-charcoal/20"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 pt-32 pb-16 w-full">
      <p class="text-gold text-xs tracking-widest uppercase mb-3 font-medium">Social Proof</p>
      <h1 class="font-display text-5xl md:text-6xl font-light text-white leading-tight">What People Say</h1>
      <p class="mt-4 text-white/70 text-lg max-w-lg">Real words from real clients and students whose lives have been touched by Rebecca's teaching.</p>
    </div>
  </section>

  <!-- Testimonials Grid -->
  <section class="section-padding max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {testimonials.map((t, i) => (
        <div class="bg-white rounded-2xl p-7 shadow-sm hover:shadow-md transition-shadow duration-200 flex flex-col">
          <!-- Stars -->
          <div class="flex gap-1 mb-4">
            {[1,2,3,4,5].map(() => (
              <svg class="w-4 h-4 text-gold" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <blockquote class="text-charcoal-light leading-relaxed mb-5 text-sm italic flex-1">
            "{t.text}"
          </blockquote>

          <!-- Attribution -->
          <div class="flex items-center gap-3 pt-4 border-t border-cream-dark">
            <div class="w-9 h-9 rounded-full bg-terracotta/20 flex items-center justify-center shrink-0">
              <span class="text-terracotta text-sm font-medium">{t.name.charAt(0)}</span>
            </div>
            <div>
              <p class="text-charcoal font-medium text-sm">{t.name}</p>
              {t.location && <p class="text-charcoal-light text-xs">{t.location}</p>}
            </div>
            <span class="ml-auto text-xs px-2 py-1 rounded-full bg-cream-dark text-charcoal-light capitalize">{t.category}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding bg-terracotta">
    <div class="max-w-4xl mx-auto px-6 text-center text-white">
      <h2 class="font-display text-4xl md:text-5xl font-light mb-5 leading-tight">
        Ready to Write<br /><em class="italic">Your Story?</em>
      </h2>
      <p class="text-white/80 mb-8 max-w-md mx-auto leading-relaxed">
        Join the many people who have discovered that happiness is a practiced skill — and that it's available to you, starting now.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <Button href="https://calendly.com/realityspirituality" variant="gold" size="lg" external>Book Free Consultation</Button>
        <Button href="/services" variant="outline" size="lg">View Services</Button>
      </div>
    </div>
  </section>

</BaseLayout>
