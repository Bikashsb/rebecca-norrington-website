---
import BaseLayout from '../components/layout/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import testimonials from '../data/testimonials.json';
import services from '../data/services.json';

const featuredServices = services.filter(s => s.featured);
const featuredTestimonials = testimonials.slice(0, 6);
---

<BaseLayout
  title="Home"
  description="Rebecca L. Norrington — Happiness Specialist, Author, Life Coach & Retreat Host. Learn the practiced skill of happiness."
>

  <!-- HERO -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/rebecca-interview.jpg"
        alt="Rebecca L. Norrington"
        class="w-full h-full object-cover object-top"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-charcoal/80 via-charcoal/50 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-charcoal/60 via-transparent to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 w-full pt-24">
      <div class="max-w-xl">
        <p class="text-gold text-xs tracking-widest uppercase mb-4 font-medium">Happiness Specialist · Author · Life Coach</p>
        <h1 class="font-display text-5xl md:text-7xl font-light text-white leading-tight mb-6">
          Rebecca L.<br />
          <em class="font-light italic">Norrington</em>
        </h1>
        <p class="text-white/80 text-lg leading-relaxed mb-3 max-w-md">
          "You cannot have a happy ending to an unhappy journey."
        </p>
        <p class="text-white/50 text-sm mb-10">— Abraham-Hicks</p>
        <p class="text-white/70 text-base leading-relaxed mb-10 max-w-sm">
          Happiness is a practiced skill. Let me show you how.
        </p>
        <div class="flex flex-wrap gap-4">
          <Button href="/services" variant="primary" size="lg">
            Work with Rebecca
          </Button>
          <Button href="https://calendly.com/realityspirituality" variant="outline" size="lg" external>
            Free Consultation
          </Button>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2 text-white/50">
      <span class="text-xs tracking-widest uppercase">Explore</span>
      <div class="w-px h-10 bg-white/30 animate-pulse"></div>
    </div>
  </section>

  <!-- HAPPINESS DEFINITION -->
  <section class="bg-cream-dark py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="text-terracotta text-xs tracking-widest uppercase mb-5 font-medium">A Different Definition</p>
      <blockquote class="font-display text-3xl md:text-5xl font-light text-charcoal leading-tight">
        "The ability to be at peace,<br class="hidden md:block" /> regardless of your circumstances."
      </blockquote>
      <p class="mt-5 text-charcoal-light text-sm tracking-wide">— Rebecca L. Norrington</p>
    </div>
  </section>

  <!-- ABOUT SNIPPET -->
  <section class="section-padding max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="relative">
        <div class="aspect-[3/4] rounded-2xl overflow-hidden bg-cream-dark">
          <img
            src="/images/rebecca-interview.jpg"
            alt="Rebecca L. Norrington"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="absolute -bottom-6 -right-6 w-32 h-32 rounded-2xl bg-terracotta/10 -z-10"></div>
        <div class="absolute -top-6 -left-6 w-24 h-24 rounded-full bg-gold/10 -z-10"></div>
      </div>

      <div>
        <p class="text-terracotta text-xs tracking-widest uppercase mb-4 font-medium">My Story</p>
        <h2 class="font-display text-4xl md:text-5xl font-light text-charcoal leading-tight mb-6">
          My Search for Happiness
        </h2>
        <div class="space-y-4 text-charcoal-light leading-relaxed">
          <p>
            Despite outward success — a wonderful son, meaningful travels, a career I loved — I found myself quietly unhappy. Something essential was missing. That journey of discovery led me to a truth that changed everything: <strong class="text-charcoal font-medium">happiness is a practiced skill, not a destination.</strong>
          </p>
          <p>
            I am a Happiness Specialist, certified fitness instructor, life coach, author, and podcast host. My approach — RealitySpirituality — blends the human experience with spiritual practices to help you find genuine, lasting peace.
          </p>
          <p>
            Sustainable happiness requires daily practice and personal responsibility. It is achievable even during hardship. I know this because I've lived it.
          </p>
        </div>
        <div class="mt-8 flex flex-wrap gap-4">
          <Button href="/about" variant="primary">My Full Story</Button>
          <Button href="/ask-rebecca" variant="outline">Ask Rebecca</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- BOOKS SPOTLIGHT -->
  <section class="bg-charcoal section-padding">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-gold text-xs tracking-widest uppercase mb-4 font-medium">Available Now</p>
          <h2 class="font-display text-4xl md:text-5xl font-light text-white leading-tight mb-6">
            The Truth About<br />
            <em class="italic text-gold">Happiness</em>
          </h2>
          <p class="text-white/70 leading-relaxed mb-8">
            In this transformative guide, Rebecca draws on decades of personal experience and professional practice to reveal what happiness truly is — and how to cultivate it as a daily skill. Whether you're navigating grief, relationship challenges, or the quiet unhappiness of a life that looks good from the outside, this book offers practical tools rooted in personal responsibility and spiritual awareness.
          </p>
          <div class="flex flex-wrap gap-4">
            <Button href="https://amzn.to/3PQttPP" variant="gold" size="lg" external>
              Buy on Amazon
            </Button>
            <Button href="/books" variant="outline" size="lg">
              View All Books
            </Button>
          </div>
        </div>

        <div class="flex justify-center lg:justify-end">
          <div class="relative">
            <div class="w-64 h-80 rounded-lg shadow-2xl bg-gradient-to-br from-terracotta to-terracotta-dark flex flex-col items-center justify-center p-8 text-white text-center">
              <div class="w-12 h-px bg-gold mb-4"></div>
              <p class="font-display text-2xl font-light leading-tight mb-2">The Truth About Happiness</p>
              <div class="w-12 h-px bg-gold mt-4 mb-6"></div>
              <p class="text-white/70 text-xs tracking-widest uppercase">Rebecca L. Norrington</p>
            </div>
            <div class="absolute inset-0 translate-x-3 translate-y-3 rounded-lg bg-black/30 -z-10"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES OVERVIEW -->
  <section class="section-padding max-w-7xl mx-auto px-6">
    <SectionHeading
      eyebrow="Work with Rebecca"
      title="Ways I Can Help You"
      subtitle="Whether you're seeking one-on-one guidance, a group course, or physical wellness — there's a path designed for where you are right now."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
      {featuredServices.map(service => (
        <div class="group p-8 rounded-2xl bg-cream-dark hover:bg-terracotta transition-all duration-300">
          <div class="flex items-start justify-between mb-6">
            <div>
              <h3 class="font-display text-2xl font-light group-hover:text-white text-charcoal mb-1">{service.title}</h3>
              <p class="text-xs text-terracotta group-hover:text-gold tracking-wide">{service.duration}</p>
            </div>
            <div class="text-right">
              <p class="font-display text-3xl text-charcoal group-hover:text-white">{service.price}</p>
            </div>
          </div>
          <p class="text-charcoal-light group-hover:text-white/80 leading-relaxed text-sm mb-6">{service.description}</p>
          <a href="/services" class="inline-flex items-center gap-1 text-sm font-medium text-terracotta group-hover:text-gold transition-colors">
            {service.cta}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      ))}
    </div>

    <div class="text-center">
      <Button href="/services" variant="outline" size="lg">View All Services & Classes</Button>
    </div>
  </section>

  <!-- RETREATS PREVIEW -->
  <section class="relative section-padding overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/Xk-QFovg-scaled.jpeg"
        alt="Retreat at A Place to Heal, Southern Oregon"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-charcoal/85 to-charcoal/50"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6">
      <div class="max-w-xl">
        <p class="text-gold text-xs tracking-widest uppercase mb-4 font-medium">Southern Oregon</p>
        <h2 class="font-display text-4xl md:text-5xl font-light text-white leading-tight mb-6">
          Retreats &<br /><em class="italic">Workshops</em>
        </h2>
        <p class="text-white/75 leading-relaxed mb-6">
          A private, secluded retreat in Southern Oregon overlooking a backyard creek. Immerse yourself in nature, guided meditation, fitness, and deep personal work — over a transformative weekend designed to reset your relationship with happiness.
        </p>

        <ul class="grid grid-cols-2 gap-3 mb-10">
          {["Guided Meditation", "Fitness Classes", "Outdoor Hot Tub", "Reiki Services", "Bonfire Experiences", "Nutrition Instruction"].map(item => (
            <li class="flex items-center gap-2 text-white/80 text-sm">
              <svg class="w-4 h-4 text-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              {item}
            </li>
          ))}
        </ul>

        <Button href="/retreats" variant="gold" size="lg">Explore the Retreat</Button>
      </div>
    </div>
  </section>

  <!-- PODCASTS / INTERVIEWS -->
  <section class="section-padding max-w-7xl mx-auto px-6">
    <SectionHeading
      eyebrow="Listen & Watch"
      title="Interviews & Podcasts"
      subtitle="Rebecca shares her insights on happiness, grief, relationships, and spiritual growth across radio, podcasts, and YouTube."
    />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
      {[
        { platform: "Podcast", title: "Practicing The Skill Of Happiness", host: "Dr. Pele", color: "bg-sage/20 border-sage" },
        { platform: "Podcast", title: "A Fresh Perspective on Grief", host: "Reclaim Your Health", color: "bg-terracotta/10 border-terracotta" },
        { platform: "Radio", title: "The Truth About Happiness", host: "BITERADIO ME", color: "bg-gold/10 border-gold" }
      ].map(item => (
        <div class={`p-6 rounded-xl border ${item.color} hover:shadow-lg transition-all duration-200`}>
          <span class="text-xs tracking-widest uppercase text-charcoal-light mb-3 block">{item.platform}</span>
          <h3 class="font-display text-xl font-light text-charcoal mb-2 leading-snug">{item.title}</h3>
          <p class="text-sm text-charcoal-light">{item.host}</p>
        </div>
      ))}
    </div>

    <div class="bg-cream-dark rounded-2xl p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-full bg-red-500 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
            <path d="M23.495 6.205a3.007 3.007 0 0 0-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 0 0 .527 6.205a31.247 31.247 0 0 0-.522 5.805 31.247 31.247 0 0 0 .522 5.783 3.007 3.007 0 0 0 2.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 0 0 2.088-2.088 31.247 31.247 0 0 0 .5-5.783 31.247 31.247 0 0 0-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/>
          </svg>
        </div>
        <div>
          <p class="font-medium text-charcoal">Watch on YouTube</p>
          <p class="text-sm text-charcoal-light">Full interviews, classes, and more</p>
        </div>
      </div>
      <Button href="https://www.youtube.com/@RebeccaNorrington" variant="secondary" external>Visit Channel</Button>
    </div>

    <div class="text-center mt-8">
      <Button href="/interviews" variant="outline">View All Interviews</Button>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section-padding bg-cream-dark">
    <div class="max-w-7xl mx-auto px-6">
      <SectionHeading
        eyebrow="From Clients & Students"
        title="What People Are Saying"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredTestimonials.map(t => (
          <div class="bg-white rounded-2xl p-7 shadow-sm hover:shadow-md transition-shadow duration-200">
            <div class="flex gap-1 mb-4">
              {[1,2,3,4,5].map(() => (
                <svg class="w-4 h-4 text-gold" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              ))}
            </div>
            <blockquote class="text-charcoal-light leading-relaxed mb-5 text-sm italic">
              "{t.text}"
            </blockquote>
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-full bg-terracotta/20 flex items-center justify-center">
                <span class="text-terracotta text-xs font-medium">{t.name.charAt(0)}</span>
              </div>
              <div>
                <p class="text-charcoal font-medium text-sm">{t.name}</p>
                {t.location && <p class="text-charcoal-light text-xs">{t.location}</p>}
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-10">
        <Button href="/testimonials" variant="outline">Read All Testimonials</Button>
      </div>
    </div>
  </section>

  <!-- DONATION CTA -->
  <section class="section-padding max-w-7xl mx-auto px-6">
    <div class="bg-gradient-to-br from-terracotta to-terracotta-dark rounded-3xl p-10 md:p-16 text-center text-white">
      <p class="text-gold text-xs tracking-widest uppercase mb-4 font-medium">Support the Mission</p>
      <h2 class="font-display text-4xl md:text-5xl font-light mb-6 leading-tight">
        Help Spread<br /><em class="italic">Happiness</em>
      </h2>
      <p class="text-white/80 max-w-md mx-auto leading-relaxed mb-8">
        Your contribution helps Rebecca continue her work — creating free content, running low-cost programs, and making happiness accessible to more people.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <Button href="https://www.paypal.com/paypalme/rebeccalnorrington/" variant="gold" size="lg" external>
          Donate via PayPal
        </Button>
        <Button href="/donation" variant="outline" size="lg">Learn More</Button>
      </div>
    </div>
  </section>

  <!-- CONSULTATION CTA -->
  <section class="section-padding bg-charcoal">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="text-gold text-xs tracking-widest uppercase mb-4 font-medium">Start Today</p>
      <h2 class="font-display text-4xl md:text-5xl font-light text-white leading-tight mb-6">
        Ready to Begin<br /><em class="italic text-gold">Your Journey?</em>
      </h2>
      <p class="text-white/70 max-w-md mx-auto leading-relaxed mb-10">
        Book a free 20-minute consultation with Rebecca to discover how her coaching, classes, or retreats can help you find lasting peace and happiness.
      </p>
      <Button href="https://calendly.com/realityspirituality" variant="gold" size="lg" external>
        Book Your Free Consultation
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
      </Button>
    </div>
  </section>

</BaseLayout>
